<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Sleep8" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <style name="Theme.Sleep8.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#10161F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Sleep8</item>
    </style>
</resources>
